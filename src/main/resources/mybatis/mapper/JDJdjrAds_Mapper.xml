<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="huihuang.proxy.ocpx.bussiness.dao.ads.IJDJdjrAdsDao">

    <resultMap id="jdMap" type="huihuang.proxy.ocpx.ads.jd.JDAdsDTO">
        <id column="id" property="id"/>
        <result column="oaid" property="oaId"/>
        <result column="idfa" property="idfa"/>
        <result column="platform" property="platform"/>
        <result column="click_time" property="clickTime"/>
        <result column="account_id" property="accountId"/>
        <result column="callback_url" property="callbackUrl"/>
        <result column="extra" property="extra"/>
        <result column="channel_name" property="channelName"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="report_status" property="reportStatus"/>
        <result column="callback_status" property="callBackStatus"/>
        <result column="callback_time" property="callBackTime"/>
    </resultMap>

    <insert id="insert" parameterType="huihuang.proxy.ocpx.ads.jd.JDAdsDTO">
        <selectKey keyProperty="id" order="AFTER" resultType="java.lang.Integer">
            SELECT LAST_INSERT_ID()
        </selectKey>
        INSERT INTO jd_jdjr_ads
        (oaid, idfa, account_id,callback_url,extra,platform,click_time,channel_name, create_time, update_time, report_status, callback_status)
        VALUES (#{oaId}, #{idfa}, #{accountId}, #{callbackUrl},#{extra},#{platform},#{clickTime},#{channelName},now(),now(), "0", "0")
    </insert>


    <update id="update" parameterType="huihuang.proxy.ocpx.ads.jd.JDAdsDTO">
        UPDATE jd_jdjr_ads
        <set>
            <if test="oaId != null">oaid = #{oaId},</if>
            <if test="idfa != null">idfa = #{idfa},</if>
            <if test="accountId != null">account_id = #{accountId},</if>
            <if test="callbackUrl != null">callback_url = #{callbackUrl},</if>
            <if test="extra != null">extra = #{extra},</if>
            <if test="platform != null">platform = #{platform},</if>
            <if test="clickTime != null">click_time = #{clickTime},</if>
            <if test="channelName != null">channel_name = #{channelName},</if>
            update_time = now(),
            <if test="reportStatus != null">report_status = #{reportStatus},</if>
            <if test="callBackStatus != null">callback_status = #{callBackStatus},</if>
            <if test="callBackTime != null">callback_time = #{callBackTime},</if>
        </set>
        where id =#{id}
    </update>


    <select id="queryJDJdjrAdsById" parameterType="java.lang.Integer" resultMap="jdMap">
        SELECT id,
               oaid,
               idfa,
               callback_url,
               account_id,
               extra,
               platform,
               click_time,
               channel_name,
               create_time,
               update_time,
               report_status,
               callback_status
        FROM jd_jdjr_ads
        WHERE id = #{id}
    </select>


</mapper>